# AsteAI API – Environment Variables
# Copy to .env.local and fill in values. Never commit secrets.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database (AWS RDS PostgreSQL) ─────────────────────────────────────────────
DATABASE_HOST=asteai-development.cfyeuu6yuuq1.ap-south-1.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_NAME=asteai
DATABASE_USER=asteai_app
DATABASE_PASSWORD=           # leave blank when DATABASE_IAM_AUTH=true
DATABASE_IAM_AUTH=true
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false  # RDS uses AWS CA not in Node's default trust store
DATABASE_MAX_POOL=20
DATABASE_IDLE_TIMEOUT_MS=30000

# ── AWS (for IAM token generation) ───────────────────────────────────────────
AWS_REGION=ap-south-1

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_64_char_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_different_64_char_secret
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── AI Service (deeptech_ai) ──────────────────────────────────────────────────
# Server-to-server base URL, and the one the browser uses for the interview
# WebSocket (defaults to AI_SERVICE_URL). deeptech_ai must allow the web origin in CORS.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PUBLIC_URL=
# = deeptech_ai AI_API_KEY
AI_SERVICE_API_KEY=
# = deeptech_ai JWT_SECRET. Signs the short-lived token the browser sends to the AI
# service; keep it different from JWT_SECRET so the AI service cannot mint logins.
AI_JWT_SECRET=
AI_TOKEN_TTL_SECONDS=1800
# = deeptech_ai ASTEAI_RESULTS_KEY. deeptech_ai posts results to
# <this API>/api/v1/internal/ai-results with it (set its ASTEAI_RESULTS_URL to that).
ASTEAI_RESULTS_KEY=

# ── Certificates ──────────────────────────────────────────────────────────────
# Printed on each certificate as <PUBLIC_WEB_URL>/verify/certificate/<id>
PUBLIC_WEB_URL=http://localhost:3000
# Folder holding logo.png (defaults to apps/api/assets when run from apps/api)
CERTIFICATE_ASSET_DIR=

# ── Payments ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
