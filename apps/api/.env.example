# AsteAI API – Environment Variables
# Copy to .env.local and fill in values. Never commit secrets.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database (AWS RDS PostgreSQL) ─────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=asteai
DATABASE_USER=asteai_app
DATABASE_PASSWORD=changeme
DATABASE_SSL=false
DATABASE_MAX_POOL=20
DATABASE_IDLE_TIMEOUT_MS=30000

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_64_char_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_different_64_char_secret
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Storage (AWS S3) ──────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_S3_BUCKET=asteai-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Email (AWS SES) ───────────────────────────────────────────────────────────
SES_FROM_ADDRESS=noreply@asteai.com

# ── AI Service ────────────────────────────────────────────────────────────────
# Internal AsteAI AI service (deeptech_ai repo)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=

# ── Payments ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
